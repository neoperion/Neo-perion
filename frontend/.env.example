# ──────────────────────────────────────────────────────────
# Neo Perion Solutions — Environment Configuration
# Copy this file to .env.local and fill in real values.
# ──────────────────────────────────────────────────────────

# Supabase (Client — Public, safe to ship to browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# EmailJS (legacy contact form path)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Analytics & Monitoring
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_ID=x9hum0rzaa

# Integrations
VITE_CALENDLY_URL=https://calendly.com/neoperion/free-call
VITE_WHATSAPP_NUMBER=919XXXXXXXXX

# Site
VITE_SITE_URL=https://www.neoperion.com
VITE_COOKIE_VERSION=1.0

# ──────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — never prefix with VITE_, never expose
# These are read by Supabase Edge Functions, not the frontend.
# ──────────────────────────────────────────────────────────

SUPABASE_SERVICE_ROLE_KEY=eyJ...
RESEND_API_KEY=re_...
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_EMAIL=admin@neoperion.com
